# LibrAI Environment Configuration
# GEMINI_API_KEY: Optional key for Google Gemini API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# LLM Provider selection: "gemini" | "ollama" | "groq" | "openai" (Default: "gemini")
LLM_PROVIDER="gemini"

# Ollama local configuration (Used when LLM_PROVIDER="ollama")
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="llama3.2"
OLLAMA_EMBED_MODEL="nomic-embed-text"

# Third-party LLM providers (Optional alternatives)
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Redis configuration: leave blank for automatic high-performance in-memory fallback adapter
# Or specify Redis URI (e.g., redis://127.0.0.1:6379, Upstash, or Redis Cloud)
REDIS_URL=""

# Storage and Chunking Strategy Parameters
CHUNK_SIZE_TOKENS="800"
CHUNK_OVERLAP_TOKENS="120"
MAX_UPLOAD_MB="10"
SESSION_TTL_SECONDS="86400"
CACHE_TTL_SECONDS="3600"
RATE_LIMIT_WINDOW_SECONDS="60"
RATE_LIMIT_MAX_REQUESTS="30"
EVIDENCE_CONFIDENCE_THRESHOLD="0.45"

