{
  "info": {
    "_postman_id": "c1f85e49-8c43-471a-9653-librai-assignment",
    "name": "LibrAI - AI Document Assistant API",
    "description": "Comprehensive Postman collection for LibrAI evaluation covering document ingestion, grounded chat, multi-turn session handling, Redis caching ('cached': true), Evidence Mode citations, rate limiting, and document deletion.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "documentId",
      "value": "doc_sample_librai_manual",
      "type": "string"
    },
    {
      "key": "sessionId",
      "value": "session_eval_user_1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. System Health & Readiness",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            },
            "description": "Checks liveness and uptime of the service."
          }
        },
        {
          "name": "Readiness & Redis Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/ready",
              "host": ["{{baseUrl}}"],
              "path": ["api", "ready"]
            },
            "description": "Checks Redis connectivity, database document counts, and LLM provider states."
          }
        },
        {
          "name": "System Configuration",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/config",
              "host": ["{{baseUrl}}"],
              "path": ["api", "config"]
            },
            "description": "Inspects safe runtime settings, chunk size, overlap parameters, and TTLs."
          }
        }
      ]
    },
    {
      "name": "2. Document Ingestion",
      "item": [
        {
          "name": "Load Sample Document (1-Click)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.document && jsonData.document.id) {",
                  "    pm.collectionVariables.set('documentId', jsonData.document.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/documents/sample",
              "host": ["{{baseUrl}}"],
              "path": ["api", "documents", "sample"]
            },
            "description": "Preloads a sample technical manual into the store for instant testing."
          }
        },
        {
          "name": "Upload Document (PDF or TXT, max 10MB)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": ""
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/documents",
              "host": ["{{baseUrl}}"],
              "path": ["api", "documents"]
            },
            "description": "Uploads and indexes PDF/TXT document with sentence boundary chunking and page metadata."
          }
        },
        {
          "name": "List Documents",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/documents",
              "host": ["{{baseUrl}}"],
              "path": ["api", "documents"]
            }
          }
        },
        {
          "name": "Get Document Details",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/documents/{{documentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "documents", "{{documentId}}"]
            }
          }
        },
        {
          "name": "Inspect Document Chunks & Page Offsets",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/documents/{{documentId}}/chunks",
              "host": ["{{baseUrl}}"],
              "path": ["api", "documents", "{{documentId}}", "chunks"]
            },
            "description": "Inspects chunk boundaries, token counts, and keyword indices."
          }
        }
      ]
    },
    {
      "name": "3. AI Grounded Chat & Evidence Mode",
      "item": [
        {
          "name": "Question 1: Supported Document Fact",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"documentId\": \"{{documentId}}\",\n  \"sessionId\": \"{{sessionId}}\",\n  \"question\": \"What is the target chunk size and overlap used in LibrAI's chunking strategy?\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/chat",
              "host": ["{{baseUrl}}"],
              "path": ["api", "chat"]
            },
            "description": "Answers based strictly on retrieved chunks. Returns citations and 'cached': false."
          }
        },
        {
          "name": "Question 2: Cache Hit Demonstration",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"documentId\": \"{{documentId}}\",\n  \"sessionId\": \"{{sessionId}}\",\n  \"question\": \"What is the target chunk size and overlap used in LibrAI's chunking strategy?\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/chat",
              "host": ["{{baseUrl}}"],
              "path": ["api", "chat"]
            },
            "description": "Repeats exact question. Returns from Redis cache with 'cached': true in under 20ms."
          }
        },
        {
          "name": "Question 3: Multi-turn Follow-up Question",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"documentId\": \"{{documentId}}\",\n  \"sessionId\": \"{{sessionId}}\",\n  \"question\": \"Why is that specific overlap window used?\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/chat",
              "host": ["{{baseUrl}}"],
              "path": ["api", "chat"]
            },
            "description": "Multi-turn question referencing previous conversation turn via sessionId."
          }
        },
        {
          "name": "Question 4: Unavailable / Out-of-Document Fact (Hallucination Test)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"documentId\": \"{{documentId}}\",\n  \"sessionId\": \"{{sessionId}}\",\n  \"question\": \"What is the CEO's favorite pizza topping and personal stock portfolio?\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/chat",
              "host": ["{{baseUrl}}"],
              "path": ["api", "chat"]
            },
            "description": "Tests strict negative grounding: model MUST refuse to invent details and state information is unavailable."
          }
        },
        {
          "name": "Get Multi-turn Session History",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/sessions/{{sessionId}}/history",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sessions", "{{sessionId}}", "history"]
            }
          }
        },
        {
          "name": "Clear Session History",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/sessions/{{sessionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sessions", "{{sessionId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Document Deletion & Cache Invalidation",
      "item": [
        {
          "name": "Delete Document (Cleans up DB, Chunks, Cache)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/documents/{{documentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "documents", "{{documentId}}"]
            },
            "description": "Removes document, chunks, and invalidates all related Redis cache keys."
          }
        }
      ]
    }
  ]
}
